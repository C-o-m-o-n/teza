{
  "name": "teza",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-01",
  // Served only on the custom domain. workers.dev is off so nobody can bypass the
  // comonhq.com zone's rate-limit rule on /api/match/* (see README "Game server").
  "routes": [{ "pattern": "teza.comonhq.com", "custom_domain": true }],
  "workers_dev": false,
  // Cloudflare serves the static build in dist/. Only /api/* runs the script first;
  // everything else is an asset (the script only sees asset misses).
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"]
  },
  // One Match Durable Object per match id, and one global Accounts instance (worker/index.ts).
  "durable_objects": {
    "bindings": [
      { "name": "MATCH", "class_name": "Match" },
      { "name": "ACCOUNTS", "class_name": "Accounts" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Match"] },
    { "tag": "v2", "new_sqlite_classes": ["Accounts"] }
  ]
}
