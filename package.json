{
  "name": "teza",
  "version": "0.1.0",
  "private": true,
  "description": "Teza (tetris + cheza, Swahili for \"play\"): a clean-room modern stacker with TETR.IO-matched mechanics.",
  "type": "module",
  "scripts": {
    "start": "node build.mjs --serve",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "build": "node build.mjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "e2e": "node build.mjs && playwright test",
    "brand": "node scripts/brand.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@playwright/test": "^1.62.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
